{
  "name": "Lộc Ấn Điều Hành",
  "short_name": "Lộc Ấn",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F7F2E9",
  "theme_color": "#8E2A1E",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./chia-se",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "file", "accept": ["*/*", "application/pdf", "image/*", ".pdf", ".ai", ".psd", ".cdr", ".eps", ".xlsx", ".xls", ".docx", ".doc", ".zip", ".rar"] }
      ]
    }
  }
}
